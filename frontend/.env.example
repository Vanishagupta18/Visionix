# Copy to frontend/.env

# Node backend (REST)
VITE_API_BASE_URL=http://localhost:5000/api

# Node backend (Socket.io - same host, no /api suffix)
VITE_SOCKET_URL=http://localhost:5000

# AI service, used ONLY for the raw MJPEG <img> stream tag - everything
# else (structured results, alerts) goes through the Node backend.
VITE_AI_SERVICE_URL=http://localhost:8000