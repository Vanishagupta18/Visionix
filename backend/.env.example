PORT=5000

# MongoDB Atlas connection string (free M0 tier), or a local mongodb:// URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/visonix

# URL of the AI service (ai-service/live_service.py)
AI_SERVICE_URL=http://localhost:8000

# Shared secret the AI service must send as the x-ingest-key header on
# POST /api/ingest/reading. Leave unset in local dev to disable the check;
# always set it before deploying anywhere reachable from the internet.
INGEST_API_KEY=change_this_to_a_long_random_string

# JWT secret for admin login
JWT_SECRET=change_this_to_a_long_random_string

# Frontend URL (for CORS and Socket.io)
FRONTEND_URL=http://localhost:5173