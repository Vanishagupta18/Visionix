# Copy this file to .env and fill in your real values. Never commit .env itself.

PORT=5000

# MongoDB Atlas connection string (free M0 tier)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/visonix

# URL of the AI service (ai-service/main.py)
AI_SERVICE_URL=http://localhost:8000

# JWT secret for admin login
JWT_SECRET=change_this_to_a_long_random_string

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
